# Mapa Apagones - ejemplo de variables de entorno
# No subas .env real al repositorio.

DB_PATH=/data/app.db
ANON_HASH_KEY=
ANON_HASH_KEY_REQUIRED=0
ANON_HASH_LEGACY_COMPAT=1

IGN_WFS_ENABLED=1
IGN_WFS_TIMEOUT=12
IGN_WFS_USER_AGENT=ApagonesCiudadanos/0.9

TURNSTILE_ENABLED=0
TURNSTILE_REQUIRED=1
TURNSTILE_SECRET_KEY=

VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=

# Producción futura:
# TURNSTILE_ENABLED=1
# TURNSTILE_SECRET_KEY=...
# VITE_API_BASE_URL=https://api.mapa-apagones.es
# VITE_TURNSTILE_SITE_KEY=...

# CORS / debug
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8098,http://127.0.0.1:8098,https://mapa-apagones.es,https://www.mapa-apagones.es
DEBUG_ENDPOINTS=0

# SQLite / backups
DB_PATH=/data/app.db
BACKUP_DIR=./backups/sqlite
KEEP_DAYS=14


# Privacidad / anonimización
# En producción, define ANON_HASH_KEY con una clave larga y aleatoria.
# ANON_HASH_LEGACY_COMPAT=1 permite reconocer temporalmente hashes antiguos sha256 durante la transición.
# ANON_HASH_KEY_REQUIRED=1 fuerza error si no hay clave de anonimización configurada.
